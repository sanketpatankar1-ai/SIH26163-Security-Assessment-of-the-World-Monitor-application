# ============================
# SIH26163 - Security Dashboard
# .gitignore
# ============================

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover
*.prof

# ── Virtual environments ────────────────────────────
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
target_app/venv/
target_app/.venv/

# ── Environment / secrets — NEVER COMMIT THESE ──────
.env
.env.local
.env.production
*.env
secrets.json
credentials.json
private_key*
*.pem
*.key

# ── Database files ───────────────────────────────────
database/*.db
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite

# ── Generated reports ────────────────────────────────
reports/*.pdf
reports/*.html

# ── Node / Frontend ──────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE / Editor ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS files ─────────────────────────────────────────
.DS_Store
desktop.ini
