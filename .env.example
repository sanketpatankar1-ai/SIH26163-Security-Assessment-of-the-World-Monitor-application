# ====================================================
# SIH26163 - World Monitor Security Assessment
# Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Backend Configuration ────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ── Frontend Configuration ───────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Target App (Simulated World Monitor) ─────────────
TARGET_APP_URL=http://localhost:5001

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./database/assessment.db

# ── Demo Mode ─────────────────────────────────────────
DEMO_MODE=true

# ── Optional: Gemini AI (for finding summarization) ──
# Leave blank to disable AI module
GEMINI_API_KEY=

# ── Security ──────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-in-production
